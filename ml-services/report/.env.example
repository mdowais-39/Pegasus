# FinIntel report service — email delivery configuration (Gmail)
#
# Setup (one-time):
#   1. Go to https://myaccount.google.com/security and turn ON "2-Step Verification"
#      (an App Password cannot be created without it).
#   2. Go to https://myaccount.google.com/apppasswords, create an app password
#      named e.g. "FinIntel Report Service", and copy the 16-character code.
#   3. Copy this file to ".env" (same folder) and fill in the SMTP_USER /
#      SMTP_PASSWORD / SMTP_FROM values below — never commit ".env" (it's
#      already gitignored).
#   4. Restart the report service (uvicorn main:app --port 8010).
#
# These are read by services/email_service.py on import.
#
# Port 465 (implicit SSL) is used here instead of 587 (STARTTLS) because
# corporate VPNs / Zero Trust clients (Cloudflare WARP, Zscaler, etc.) commonly
# do TLS inspection that corrupts the STARTTLS upgrade on 587, surfacing as
# `ssl.SSLError: [ASN1: NOT_ENOUGH_DATA]`. 465 is TLS from the first byte, with
# no mid-stream upgrade, and is far more resilient to that kind of interception.
# If your network has no such proxy, 587/STARTTLS works equally well — set
# SMTP_PORT=587 and SMTP_USE_TLS=true instead.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_TLS=false

# Your full Gmail address
SMTP_USER=youraddress@gmail.com
# The 16-character App Password from step 2 (NOT your normal Gmail password)
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional: override the From address shown to recipients (defaults to SMTP_USER)
SMTP_FROM=youraddress@gmail.com
